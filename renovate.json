{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeStrategy": "rebase",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/install\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\S+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "ignoreTests": true,
  "packageRules": [
    {
      "description": "Group CI updates",
      "matchManagers": ["github-actions"],
      "groupName": "CI dependencies"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
